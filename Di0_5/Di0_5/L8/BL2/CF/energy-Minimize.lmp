# series runs - one by one - minimization
units  lj
boundary p p p
atom_style full
read_data initialsys.config
log log-min.txt
include forcefield.lmp

#groups
group g1 molecule 2
group mobile subtract all g1

# Input parameter initialisation
neigh_modify every 1 delay 0 check yes page 100000 one 10000

# Minimization first to fix overlapping atoms
minimize 1.0e-4 1.0e-6 1000 10000
write_restart restart.min

# Reset velocity after minimization (Applied ONLY to mobile atoms)
velocity mobile create 1.0 4928459 rot yes dist gaussian

# Fix double thermostat - g1 only thermostated by fix 2
fix 1 all nvt temp 1.0 1.0 100
fix 2 g1 rigid/nvt molecule temp 1.0 1.0 1.0

thermo 20000
thermo_style custom step temp press vol density pe ke etotal spcpu

# Lowered timestep for harmonic bond stability in LJ units
timestep 0.001

dump 1 all dcd 100 trajmin.dcd
dump_modify 1 unwrap yes

run 1000000
write_data after.config
print " ******* "
print " ****** finished NVT run *******"
print " ******* "
print "Done"